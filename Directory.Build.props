<Project>
  <PropertyGroup>
    <!--
      OllamaSharp 5.4.30 ships an optional generator compiled against Roslyn 5.6,
      while the .NET 10.0.101 SDK uses Roslyn 5.0. The client library works without
      the generator; remove this suppression when the package versions align.
    -->
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>
</Project>
