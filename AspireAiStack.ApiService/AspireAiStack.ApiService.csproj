<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- OllamaSharp 5.4.30 ships an optional generator built with a newer Roslyn. -->
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireAiStack.ServiceDefaults\AspireAiStack.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Qdrant.Client" Version="13.5.3" />
    <PackageReference Include="Aspire.StackExchange.Redis" Version="13.5.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" ExcludeAssets="analyzers" />
  </ItemGroup>

</Project>
