@page "/"
@rendermode InteractiveServer
@inject AiStackApiClient ApiClient
@inject IConfiguration Configuration

<PageTitle>Aspire AI Stack</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">A practical distributed AI development loop</p>
        <h1>Orchestrate the whole AI stack without hiding its boundaries.</h1>
        <p class="lede">
            Aspire starts and connects the services. The API keeps credentials server-side,
            retrieves grounding context, caches repeat requests, and emits telemetry for the dashboard.
        </p>
    </div>
    @if (_status is not null)
    {
        <StackStatusCard Status="_status" />
    }
    @if (!string.IsNullOrWhiteSpace(_dashboardUrl))
    {
        <aside class="dashboard-card" aria-label="Aspire dashboard">
            <p class="status-label">Evidence review</p>
            <a href="@_dashboardUrl" target="_blank" rel="noopener noreferrer">Open the Aspire dashboard ↗</a>
            <p>Inspect service health, logs, traces, and metrics from the same Compose run.</p>
        </aside>
    }
</section>

<section class="topology" aria-label="Application topology">
    <div class="topology-node primary">Blazor UI</div>
    <span aria-hidden="true">→</span>
    <div class="topology-node">ASP.NET Core API</div>
    <span aria-hidden="true">→</span>
    <div class="topology-node">Qdrant</div>
    <div class="topology-node">Redis</div>
    <div class="topology-node">Ollama</div>
</section>

<section class="demo-panel">
    <div class="demo-copy">
        <p class="eyebrow">Try the verified first-run flow</p>
        <h2>Ask about the architecture</h2>
        <p>
            This demo uses seven preloaded architecture notes covering Aspire orchestration,
            service references, observability, local AI, vector search, caching, and production boundaries.
        </p>
        <div class="demo-expectation">
            <h3>What you should see</h3>
            <ol>
                <li>Submit the prefilled question and look for a <strong>fresh response</strong> with three retrieved context items.</li>
                <li>Submit the same question again and look for <strong>cache hit</strong> with the identical answer.</li>
                <li>Choose a seeded topic below; its suggested question will replace the prompt and produce a fresh response.</li>
            </ol>
            <p>The first Qdrant-backed request can take a little longer while the seven demo notes are seeded.</p>
        </div>
        @if (_topics.Count > 0)
        {
            <div class="seeded-topics">
                <h3>Seeded topics you can ask about</h3>
                <p>These suggestions come from the same catalog used to ground the answer.</p>
                <ul class="seeded-topic-list">
                    @foreach (var topic in _topics)
                    {
                        <li>
                            <button class="seeded-topic" type="button" @onclick="() => SelectTopic(topic.SuggestedQuestion)">
                                <strong>@topic.Title</strong>
                                <span>@topic.SuggestedQuestion</span>
                            </button>
                        </li>
                    }
                </ul>
            </div>
        }
        <p class="demo-note">
            The default mode is deterministic and credential-free. Enable Ollama for real local model generation.
        </p>
    </div>

    <form @onsubmit="AskAsync" @onsubmit:preventDefault>
        <label for="prompt">Question</label>
        <textarea id="prompt" @bind="_prompt" rows="4" placeholder="How does Aspire connect the API to Qdrant?"></textarea>
        <button class="btn btn-primary" type="submit" disabled="@_isLoading">
            @(_isLoading ? "Asking…" : "Ask the stack")
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="alert alert-danger" role="alert">@_error</p>
        @if (_initializationFailed)
        {
            <button class="btn btn-secondary" type="button" @onclick="LoadAsync" disabled="@_isInitializing">
                @(_isInitializing ? "Retrying…" : "Retry loading the demo")
            </button>
        }
    }

    @if (_response is not null)
    {
        <article class="response-card" aria-live="polite">
            <div class="response-heading">
                <h3>Grounded response</h3>
                <span class="badge @(_response.CacheHit ? "cache-hit" : "cache-miss")">
                    @(_response.CacheHit ? "cache hit" : "fresh response")
                </span>
            </div>
            <p>@_response.Answer</p>
            <dl class="response-metadata">
                <div><dt>AI mode</dt><dd>@_response.AiMode</dd></div>
                <div><dt>Vector store</dt><dd>@_response.VectorStore</dd></div>
                <div><dt>Cache</dt><dd>@_response.Cache</dd></div>
            </dl>
            <h4>Retrieved context</h4>
            <ol class="source-list">
                @foreach (var source in _response.Sources)
                {
                    <li><strong>@source.Title</strong><span>@source.Content</span></li>
                }
            </ol>
        </article>
    }
</section>

@code {
    private string _prompt = "How does Aspire connect the API to Qdrant?";
    private string? _dashboardUrl;
    private StackStatus? _status;
    private IReadOnlyList<KnowledgeTopic> _topics = [];
    private ChatResponse? _response;
    private string? _error;
    private bool _isLoading;
    private bool _isInitializing;
    private bool _initializationFailed;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isInitializing = true;
        _initializationFailed = false;
        _error = null;
        _dashboardUrl = Configuration["Demo:DashboardUrl"];

        try
        {
            _status = await ApiClient.GetStatusAsync();
            _topics = await ApiClient.GetTopicsAsync();
        }
        catch (HttpRequestException)
        {
            _error = "The API is not ready yet. Check the Aspire dashboard and retry.";
            _initializationFailed = true;
        }
        finally
        {
            _isInitializing = false;
        }
    }

    private void SelectTopic(string question)
    {
        _prompt = question;
        _response = null;
        _error = null;
    }

    private async Task AskAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt))
        {
            _error = "Enter a question before submitting.";
            return;
        }

        _isLoading = true;
        _initializationFailed = false;
        _error = null;
        try
        {
            _response = await ApiClient.AskAsync(_prompt);
        }
        catch (HttpRequestException exception)
        {
            _error = $"The request failed: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
