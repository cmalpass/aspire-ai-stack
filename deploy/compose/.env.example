# Safe local-demo values. `aspire deploy` replaces these with generated values
# and builds the two application images before starting the Compose project.
APISERVICE_IMAGE=aspire-ai-stack-apiservice:local
APISERVICE_PORT=8080
CACHE_PASSWORD=aspire-demo-only
QDRANT_KEY=aspire-demo-only
WEBFRONTEND_IMAGE=aspire-ai-stack-webfrontend:local
WEBFRONTEND_PORT=8080
